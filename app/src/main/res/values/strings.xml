    <string name="permission_location_rationale_title">Location permission needed</string>
    <string name="permission_location_rationale_body">Car Finder needs your location to remember where you parked. Allow precise location, then enable background access so it works after Bluetooth disconnects.</string>
    <string name="permission_background_rationale_title">Allow location all the time</string>
    <string name="permission_background_rationale_body">When your car\'s Bluetooth disconnects, Car Finder is in the background — Android only lets it fetch the parking fix if location is set to \"Allow all the time\". Tap Grant and choose \"Allow all the time\" on the next screen.</string>
    <string name="permission_notifications_rationale_title">Notifications</string>
    <string name="permission_notifications_rationale_body">Allow notifications so Car Finder can confirm when your parking location is saved and offer the one-tap shortcut to add bay details.</string>
    <string name="permission_battery_rationale_title">Let Car Finder run when parked</string>
    <string name="permission_battery_rationale_body">Android blocks background apps from starting the parking capture unless they\'re exempt from battery optimisation. Without this, automatic capture may silently never run. Tap Grant and choose \"Allow\".</string>
